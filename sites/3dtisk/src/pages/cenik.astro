---
import Layout from '@nk/shared/components/Layout.astro'
import { getCollection, render } from 'astro:content'

const entry = (await getCollection('cenik'))[0]
const { Content } = await render(entry)
const d = entry.data
---
<Layout title="Ceník" accent="#C2410C" terms brand="3D TISK · NAKLICOVE.CZ">
  <h1 class="display">CENÍK</h1>
  <div class="tile" style="margin-top:1rem"><span class="tile-bar"></span>
    <div class="price">
      <div class="row"><span>Materiál</span><span>Kč/g</span></div>
      {d.materials.map(m => <div class="row"><span>{m.name}</span><span>{m.price_per_g.toFixed(2).replace('.', ',')} Kč/g</span></div>)}
    </div>
    <p class="poznamka">Příprava tisku {d.fix} Kč (nad {d.fix_free_over_g} g ne) · Minimum {d.min_order} Kč · modelování [DOPLNIT] Kč/h.</p>
  </div>
  <div style="margin-top:1rem"><Content /></div>
</Layout>
<style>.price .row{display:flex;justify-content:space-between;gap:2rem;border-bottom:2px solid var(--ink);padding:.45rem .2rem}.poznamka{font-size:.85rem;color:var(--muted);margin-top:.8rem}</style>
