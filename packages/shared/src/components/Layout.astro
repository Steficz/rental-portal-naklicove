---
import '../styles/tokens.css'
import CookieBar from './CookieBar.astro'

const props = Astro.props as {
  title: string
  description?: string
  accent?: string
  brand?: string
  home?: string
}

const accent = props.accent ?? '#C2410C'
const brand = props.brand ?? 'NAKLICOVE.CZ'
const home = props.home ?? 'https://naklicove.cz'
---

<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{props.title} — naklicove.cz</title>
  {props.description && <meta name="description" content={props.description} />}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700;800&display=swap" rel="stylesheet">
</head>
<body style={`--acc:${accent}`}>
  <div class="page">
    <header class="site">
      <a class="brand" href={home}>{brand}</a>
      <slot name="header-extra" />
    </header>
    <main>
      <slot />
    </main>
  </div>
  <footer class="site">
    <div>© 2026 [PROVOZOVATEL DOPLNIT] · Ke Kličovu 8, Praha 9</div>
    <div class="legal">
      <a href="#">Obchodní podmínky</a>·<a href="#">Ochrana údajů</a>·<a href="#">Cookies</a>
    </div>
  </footer>
  <CookieBar />
</body>
</html>
